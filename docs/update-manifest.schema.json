{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mhacrzsy43/reactor/releases/download/schema/update-manifest-v1.json",
  "title": "Reactor signed update manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channel", "version", "publishedAt", "compatibility", "artifacts", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "channel": { "enum": ["stable", "beta"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumAppVersion", "databaseSchema", "flowSchemas", "resultSchemas"],
      "properties": {
        "minimumAppVersion": { "type": "string" },
        "databaseSchema": { "type": "integer", "minimum": 1 },
        "flowSchemas": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "uniqueItems": true },
        "resultSchemas": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "uniqueItems": true }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "arch", "url", "sha256", "size"],
        "properties": {
          "platform": { "enum": ["darwin", "windows", "linux"] },
          "arch": { "enum": ["aarch64", "x86_64"] },
          "url": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "minLength": 8 },
        "value": { "type": "string", "minLength": 40 }
      }
    }
  }
}
