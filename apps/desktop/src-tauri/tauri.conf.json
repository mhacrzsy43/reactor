{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reactor",
  "version": "0.1.0",
  "identifier": "com.reactor.performance",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Reactor",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI-driven mobile performance testing",
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "../../../.reactor/downloads": "managed-tool-archives"
    }
  }
}
